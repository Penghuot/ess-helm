# ===== MAS core =====
MAS_PUBLIC_URL=http://localhost:8080
MAS_LISTEN_ADDR=0.0.0.0:8080
MAS_PUBLIC_BASE=http://localhost:8080
# ===== Database (host Postgres) =====
MAS_DATABASE_URI=postgresql://mas:maspass@host.docker.internal:5434/mas

# ===== Synapse integration =====
MAS_MATRIX_ENDPOINT=http://host.docker.internal:8008
MAS_MATRIX_SERVER_NAME=localhost
MAS_MATRIX_SHARED_SECRET=local_shared_secret_123
MAS_MATRIX_HOMESERVER=localhost
# ===== OIDC client (Synapse) =====
MAS_CLIENT_ID=synapse
MAS_CLIENT_SECRET=local_shared_secret_123
MAS_CLIENT_REDIRECT_URI=http://localhost:8008/_synapse/client/oidc/callback

# ===== Crypto =====
MAS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

