# ===== MAS core =====
MAS_PUBLIC_URL=http://mas:8080
MAS_LISTEN_ADDR=0.0.0.0:8080
MAS_PUBLIC_BASE=http://mas:8080
# ===== Database (host Postgres) =====
MAS_DATABASE_URI=postgresql://mas:maspass@mas-db:5432/mas

# ===== Synapse integration =====
MAS_MATRIX_ENDPOINT=http://synapse:8008
MAS_MATRIX_SERVER_NAME=localhost
MAS_MATRIX_SHARED_SECRET=local_registration_secret_12345678901234567890
MAS_MATRIX_HOMESERVER=localhost
# ===== OIDC client (Synapse) =====
MAS_CLIENT_ID=0000000000000000000SYNAPSE
MAS_CLIENT_SECRET=local_client_secret_1234567890abcdefghijklmnop
MAS_CLIENT_REDIRECT_URI=http://localhost:8008/_synapse/client/oidc/callback

# ===== Crypto =====
MAS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== Misc =====
MAS_EMAIL_DOMAIN=localhost