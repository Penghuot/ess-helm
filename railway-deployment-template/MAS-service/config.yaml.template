# ============================================================================
# MAS Configuration Template
# ============================================================================
# Environment variables are substituted at runtime by entrypoint.sh
# ============================================================================

http:
  public_base: ${MAS_PUBLIC_BASE}
  listeners:
    - name: web
      binds:
        - address: "0.0.0.0:8080"
      proxy_protocol: false
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: compat
        - name: graphql
        - name: assets

database:
  uri: ${DATABASE_URL}

secrets:
  encryption: ${MAS_ENCRYPTION_SECRET}
  keys:
    - kid: "default"
      key: |
${MAS_SIGNING_KEY}

matrix:
  homeserver: ${MAS_MATRIX_HOMESERVER}
  endpoint: ${MAS_MATRIX_ENDPOINT}
  secret: ${MAS_MATRIX_SECRET}

upstream_oauth2:
  providers: []

clients:
  - client_id: "0000000000000000000SYNAPSE"
    client_auth_method: "client_secret_basic"
    client_secret: ${MAS_CLIENT_SECRET}

email:
  from: '"Matrix" <noreply@${MAS_MATRIX_HOMESERVER}>'
  reply_to: '"Matrix Support" <support@${MAS_MATRIX_HOMESERVER}>'
  transport: blackhole

passwords:
  enabled: true
  schemes:
    - version: 1
      algorithm: argon2id

branding:
  service_name: "Matrix Authentication Service"
    burst: ${MAS_RATE_LIMIT_REGISTRATION_BURST:-3}

# Captcha configuration (optional, for bot protection)
captcha:
  enabled: ${MAS_CAPTCHA_ENABLED:-false}
  # service: recaptcha
  # site_key: ${RECAPTCHA_SITE_KEY}
  # secret_key: ${RECAPTCHA_SECRET_KEY}

# Telemetry (optional)
telemetry:
  tracing:
    enabled: ${MAS_TRACING_ENABLED:-false}
    # exporter: jaeger
    # endpoint: http://jaeger:14268/api/traces
  
  metrics:
    enabled: ${MAS_METRICS_ENABLED:-false}
    # exporter: prometheus
    # endpoint: 0.0.0.0:9090

# Logging configuration
logging:
  # Log level: trace, debug, info, warn, error
  level: ${MAS_LOG_LEVEL:-info}
  
  # Log format: json, pretty, compact
  format: ${MAS_LOG_FORMAT:-json}
