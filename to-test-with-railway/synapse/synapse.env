# ===== Core =====
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_PUBLIC_BASEURL=http://localhost:8008/

# ===== Database =====
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapsepass
SYNAPSE_DB_HOST=synapse-db
SYNAPSE_DB_PORT=5432
SYNAPSE_DB_NAME=synapse

# ===== Secrets =====
SYNAPSE_MACAROON_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SYNAPSE_FORM_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ===== Registration =====
# Disabled - users register through MAS instead
SYNAPSE_ENABLE_REGISTRATION=false
SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION=false

# ===== MAS Integration (MSC3861) =====
MAS_MATRIX_ENDPOINT=http://mas:8080
MAS_CLIENT_ID=0000000000000000000SYNAPSE
MAS_CLIENT_SECRET=local_client_secret_1234567890abcdefghijklmnop
MAS_MATRIX_SHARED_SECRET=local_registration_secret_12345678901234567890
