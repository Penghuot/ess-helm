# ==========================================
# Railway Environment Variables Template
# ==========================================
# Copy these to Railway's Environment Variables tab
# Replace all <placeholders> with actual values

# -------------------
# Synapse Variables
# -------------------
SYNAPSE_SERVER_NAME=<your-synapse-railway-domain>
SYNAPSE_PUBLIC_BASEURL=https://<your-synapse-railway-domain>/
SYNAPSE_DB_USER=${{synapse-db.PGUSER}}
SYNAPSE_DB_PASSWORD=${{synapse-db.PGPASSWORD}}
SYNAPSE_DB_HOST=${{synapse-db.PGHOST}}
SYNAPSE_DB_PORT=${{synapse-db.PGPORT}}
SYNAPSE_DB_NAME=${{synapse-db.PGDATABASE}}

# Secrets (generate with: openssl rand -hex 32)
SYNAPSE_REGISTRATION_SHARED_SECRET=<generate-with-openssl-rand-hex-32>
SYNAPSE_MACAROON_SECRET_KEY=<generate-with-openssl-rand-hex-32-64-chars>
SYNAPSE_FORM_SECRET=<generate-with-openssl-rand-hex-32-64-chars>

# Registration flags (DISABLED - use MAS for registration)
SYNAPSE_ENABLE_REGISTRATION=false
SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION=false

# MAS OIDC Configuration
MAS_MATRIX_ENDPOINT=https://<your-mas-railway-domain>
MAS_CLIENT_ID=0000000000000000000SYNAPSE
MAS_CLIENT_SECRET=<generate-client-secret-40plus-chars>

# -------------------
# MAS Variables
# -------------------
MAS_PUBLIC_BASE=https://${{RAILWAY_PUBLIC_DOMAIN}}
MAS_PUBLIC_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
MAS_LISTEN_ADDR=0.0.0.0:8080

# Database (Railway will provide this automatically)
MAS_DATABASE_URI=${{mas-db.DATABASE_URL}}

# Synapse Integration
MAS_MATRIX_HOMESERVER=<your-synapse-railway-domain>
MAS_MATRIX_ENDPOINT=https://<your-synapse-railway-domain>
MAS_MATRIX_SERVER_NAME=<your-synapse-railway-domain>
MAS_MATRIX_SHARED_SECRET=<same-as-SYNAPSE_REGISTRATION_SHARED_SECRET>

# OIDC Client Configuration
MAS_CLIENT_ID=0000000000000000000SYNAPSE
MAS_CLIENT_SECRET=<same-as-above-client-secret>
MAS_CLIENT_REDIRECT_URI=https://<your-synapse-railway-domain>/_synapse/client/oidc/callback

# Secrets (generate with: openssl rand -hex 32)
MAS_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32-64-chars>

# Signing key - Generate with: openssl ecparam -name prime256v1 -genkey -noout
# Paste the entire PEM key including BEGIN/END lines
MAS_SIGNING_KEY=-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIPbNGuhF+GKc518oiHwF5xTkeOUpolcuv2jRzil2lTS/oAoGCCqGSM49
AwEHoUQDQgAETFBXoM8skKNR59t8hH02xoVZLBZIw490xw8NzFxqgIoJCsRyLWGo
G0P7fQvTXi9mFFaIordrtaqUIZK5hoSFTQ==
-----END EC PRIVATE KEY-----

MAS_EMAIL_DOMAIN=<your-domain-or-railway-domain>

# -------------------
# Element Web Variables
# -------------------
ELEMENT_DEFAULT_HS=https://<your-synapse-railway-domain>
ELEMENT_DEFAULT_SERVER_NAME=<your-synapse-railway-domain>
ELEMENT_DEFAULT_THEME=light

# ==========================================
# IMPORTANT NOTES:
# ==========================================
# 1. MAS_CLIENT_ID must be at least 28 characters
# 2. All secrets should be 64 hex characters (32 bytes)
# 3. MAS_CLIENT_SECRET should be 40+ characters
# 4. The same MAS_CLIENT_SECRET must be used in both MAS and Synapse
# 5. The same MAS_CLIENT_ID must be used in both MAS and Synapse
# 6. Generate new signing key for production: openssl ecparam -name prime256v1 -genkey -noout
# 7. Registration is DISABLED in Synapse - users register through MAS
# 8. HTTPS is automatic on Railway
# 9. Railway variables like ${{service.VARIABLE}} are auto-injected
# ==========================================