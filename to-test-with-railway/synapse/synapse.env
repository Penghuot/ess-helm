# ===== Core =====
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_PUBLIC_BASEURL=http://localhost:8008/

# ===== Database =====
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapsepass
SYNAPSE_DB_HOST=host.docker.internal
SYNAPSE_DB_PORT=5433
SYNAPSE_DB_NAME=synapse

# ===== Secrets =====
SYNAPSE_REGISTRATION_SHARED_SECRET=local_registration_secret
SYNAPSE_MACAROON_SECRET_KEY=0123456789abcdef0123456789abcdef
SYNAPSE_FORM_SECRET=abcdef0123456789abcdef0123456789

# ===== Registration =====
SYNAPSE_ENABLE_REGISTRATION=false
SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION=false

# ===== MAS (OIDC client) =====
MAS_MATRIX_ENDPOINT=http://localhost:8080
MAS_CLIENT_ID=synapse
MAS_CLIENT_SECRET=local_shared_secret_123
