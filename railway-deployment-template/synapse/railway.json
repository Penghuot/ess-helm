{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "synapse/Dockerfile"
  },
  "deploy": {
    "startCommand": "/entrypoint.sh run",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/_matrix/static/",
    "healthcheckTimeout": 100
  }
}
