{
  "default_server_config": {
    "m.homeserver": {
      "base_url": "{{HOMESERVER_URL}}",
      "server_name": "{{SERVER_NAME}}"
    },
    "m.identity_server": {
      "base_url": "https://vector.im"
    }
  },
  "auth": {
    "mas": {
      "base_url": "{{MAS_URL}}"
    }
  },
  
  "oidc_static_clients": {
    "{{MAS_URL}}/": {
      "client_id": "{{ELEMENT_WEB_CLIENT_ID}}",
      "redirect_uri": "https://web-element-production-1fad.up.railway.app/#/welcome"
    }
  },
  "element_call": {
    "url": "{{ELEMENT_CALL_URL}}",
    "use_exclusively": false,
    "participant_limit": 20
  },
  "brand": "Element",
  "default_theme": "{{ELEMENT_DEFAULT_THEME}}",
  "show_labs_settings": true,
  "disable_guests": true,
  "disable_login_language_selector": true,
  "features": {
    "feature_oidc_native_flow": true,
    "feature_element_call_video_rooms": true
  },
  "setting_defaults": {
    "theme": "{{ELEMENT_DEFAULT_THEME}}"
  }
}
