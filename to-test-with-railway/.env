# -------------------
# Synapse Variables
# -------------------
SYNAPSE_SERVER_NAME=localhost:8008
SYNAPSE_PUBLIC_BASEURL=http://localhost:8008/
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapsepass
SYNAPSE_DB_HOST=host.docker.internal
SYNAPSE_DB_PORT=5433
SYNAPSE_DB_NAME=synapse

# Secrets (generate with: openssl rand -hex 32)
SYNAPSE_REGISTRATION_SHARED_SECRET=nMXMz-q1xtz3t&~r+hetzWs,0O*VZ:QXIfuKmbNFC7tEt0Tq4x
SYNAPSE_MACAROON_SECRET_KEY=changeme_macaroon_secret
SYNAPSE_FORM_SECRET=changeme_form_secret

# Registration flags
SYNAPSE_ENABLE_REGISTRATION=true
SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION=false

# -------------------
# MAS Variables
# -------------------
MAS_PUBLIC_BASE=http://localhost:8080/
MAS_DATABASE_URI=postgresql://mas:maspass@host.docker.internal:5434/mas
MAS_MATRIX_HOMESERVER=localhost
MAS_MATRIX_ENDPOINT=http://host.docker.internal:8008
MAS_MATRIX_SHARED_SECRET=localsharedsecret123

MAS_CLIENT_ID=0000000000000000000SYNAPSE
MAS_CLIENT_SECRET=localclientsecret123

# Secrets (generate with: openssl rand -hex 32)
MAS_ENCRYPTION_KEY=changeme_encryption_key
