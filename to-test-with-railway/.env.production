# RMSS (Railway) - Production Environment Variables (placeholders)

# ===== Synapse =====
SYNAPSE_SERVER_NAME=matrix.example.com
SYNAPSE_PUBLIC_BASEURL=https://matrix.example.com/
SYNAPSE_DB_USER=railway
SYNAPSE_DB_PASSWORD=${{RAILWAY_SECRET_SYNAPSE_DB_PASSWORD}}
SYNAPSE_DB_HOST=${{RAILWAY_SECRET_SYNAPSE_DB_HOST}}
SYNAPSE_DB_PORT=5432
SYNAPSE_DB_NAME=${{RAILWAY_SECRET_SYNAPSE_DB_NAME}}
SYNAPSE_MACAROON_SECRET_KEY=${{RAILWAY_SECRET_SYNAPSE_MACAROON_SECRET_KEY}}
SYNAPSE_FORM_SECRET=${{RAILWAY_SECRET_SYNAPSE_FORM_SECRET}}

# MSC3861 (MAS integration)
MAS_MATRIX_ENDPOINT=https://auth.example.com
MAS_CLIENT_ID=${{RAILWAY_SECRET_MAS_CLIENT_ID}}
MAS_CLIENT_SECRET=${{RAILWAY_SECRET_MAS_CLIENT_SECRET}}
MAS_MATRIX_SHARED_SECRET=${{RAILWAY_SECRET_MAS_MATRIX_SHARED_SECRET}}

# ===== MAS =====
MAS_PUBLIC_BASE=https://auth.example.com
MAS_DATABASE_URI=${{RAILWAY_SECRET_MAS_DATABASE_URI}}
MAS_MATRIX_HOMESERVER=matrix.example.com
MAS_MATRIX_ENDPOINT=https://matrix.example.com
MAS_MATRIX_SHARED_SECRET=${{RAILWAY_SECRET_MAS_MATRIX_SHARED_SECRET}}
MAS_CLIENT_ID=${{RAILWAY_SECRET_MAS_CLIENT_ID}}
MAS_CLIENT_SECRET=${{RAILWAY_SECRET_MAS_CLIENT_SECRET}}
MAS_ENCRYPTION_KEY=${{RAILWAY_SECRET_MAS_ENCRYPTION_KEY}}
MAS_EMAIL_DOMAIN=example.com
MAS_SIGNING_KEY=${{RAILWAY_SECRET_MAS_SIGNING_KEY}}

# ===== Matrix RTC (LiveKit SFU) =====
LIVEKIT_API_KEY=${{RAILWAY_SECRET_LIVEKIT_API_KEY}}
LIVEKIT_API_SECRET=${{RAILWAY_SECRET_LIVEKIT_API_SECRET}}
LIVEKIT_WS_URL=wss://rtc.example.com
LIVEKIT_HTTP_URL=https://rtc.example.com

# ===== Element Web =====
ELEMENT_PUBLIC_BASEURL=https://chat.example.com
ELEMENT_DEFAULT_HS_URL=https://matrix.example.com
ELEMENT_DEFAULT_IS_URL=https://vector.im
